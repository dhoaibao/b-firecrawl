{
  "name": "@firecrawl-gateway/api",
  "version": "2.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "bun run build && node scripts/dev.mjs",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
