{
  "name": "firecrawl-gateway",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "bun --env-file=\"$(pwd)/.env\" node_modules/.bin/turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "bun --env-file=\"$(pwd)/.env\" --cwd apps/api prisma generate",
    "db:migrate": "bun --env-file=\"$(pwd)/.env\" --cwd apps/api prisma migrate deploy"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
