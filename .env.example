# Firecrawl Gateway
# Copy to .env and configure the external services:
#   cp .env.example .env

# ----------------------------------------------------------------------------
# Upstreams
# ----------------------------------------------------------------------------

# Externally hosted Firecrawl API used for local-first/local-only routing.
LOCAL_FIRECRAWL_URL=https://your-firecrawl-instance.example.com

# Firecrawl Cloud API endpoint.
FIRECRAWL_CLOUD_URL=https://api.firecrawl.dev

# Routing default. The live value can be changed in the Admin UI.
# - local-first: use the external Firecrawl instance first, then eligible Cloud fallback
# - local-only: never send requests to Cloud
# - cloud-first: use Firecrawl Cloud first, then eligible external-instance fallback
# - cloud-only: use Firecrawl Cloud exclusively
DEFAULT_ROUTE_MODE=local-first

# ----------------------------------------------------------------------------
# Gateway
# ----------------------------------------------------------------------------

GATEWAY_PORT=8080
GATEWAY_REQUEST_TIMEOUT_MS=120000
GATEWAY_LOG_FILE=/data/hybrid-firecrawl-requests.jsonl
GATEWAY_MAX_BODY_BYTES=5242880
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Authentication and admin
# ----------------------------------------------------------------------------

AUTH_ENABLED=true
CORS_ORIGIN=
TRUST_PROXY=false
SESSION_SECURE=
SESSION_SECRET=change-me-to-a-long-random-string
BCRYPT_ROUNDS=12
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# PostgreSQL database managed outside this Compose stack.
DATABASE_URL=postgresql://user:password@postgres.example.com:5432/firecrawl_gateway
