# Hybrid Firecrawl Gateway + self-host Firecrawl
#
# Copy this file to .env and fill in the values you need:
#   cp .env.example .env

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------

# Public port for the Hybrid Gateway.
# Use this endpoint from clients instead of calling Firecrawl directly.
GATEWAY_PORT=8080

# Routing default:
# - local-first: try self-host first, fallback to Cloud when eligible
# - local-only: never send requests to Cloud
# - cloud-first: send all API requests to Firecrawl Cloud
DEFAULT_ROUTE_MODE=local-first

# Firecrawl Cloud endpoint.
FIRECRAWL_CLOUD_URL=https://api.firecrawl.dev

# Required for cloud-first and Cloud fallback.
# Leave empty if you only use local-only/local self-host behavior.
FIRECRAWL_API_KEY=

# Upstream timeout used by the gateway when calling local or Cloud Firecrawl.
GATEWAY_REQUEST_TIMEOUT_MS=120000

# Path to the gateway audit log file.
GATEWAY_LOG_FILE=/data/hybrid-firecrawl-requests.jsonl

# Maximum request body size the gateway will read for inspection (bytes).
GATEWAY_MAX_BODY_BYTES=5242880

# Pino logger level.
LOG_LEVEL=info

# Enable/disable product auth features (users, API keys, sessions).
# When false the gateway behaves as a simple transparent proxy.
AUTH_ENABLED=true

# CORS origin for the gateway. Defaults to allowing all origins.
# Set to a specific origin (e.g., http://localhost:3000) for security in production.
# CORS_ORIGIN=

# PostgreSQL connection used by the gateway for users, API keys, and sessions.
# Uses the bundled nuq-postgres service by default.
DATABASE_URL=postgresql://postgres:postgres@nuq-postgres:5432/postgres

# Session cookie secret. Change to a strong random string in production.
# If left empty the gateway generates a random secret on boot (not recommended for production).
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true/false to force the session cookie Secure flag.
# When left empty it defaults to true when NODE_ENV=production.
SESSION_SECURE=

# Cost factor for bcrypt password hashing.
BCRYPT_ROUNDS=12

# Admin user bootstrapped on first start (only if no users exist).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Self-host Firecrawl API
# -----------------------------------------------------------------------------

# Exposes the local Firecrawl API directly on the host.
# Clients should normally call GATEWAY_PORT instead.
PORT=3002
INTERNAL_PORT=3002
HOST=0.0.0.0

# Default self-host mode. Keep false unless you have built the full DB auth stack.
USE_DB_AUTHENTICATION=false

# Protects the Bull queue admin UI:
#   http://localhost:${PORT}/admin/${BULL_AUTH_KEY}/queues
BULL_AUTH_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# AI features
# -----------------------------------------------------------------------------

# Needed for JSON extraction / extract features if you use OpenAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional Ollama / OpenAI-compatible local model setup.
OLLAMA_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------

# Optional SearXNG endpoint for local search.
# If empty, Firecrawl falls back to its built-in search behavior.
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=

# -----------------------------------------------------------------------------
# Proxy
# -----------------------------------------------------------------------------

PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------

SELF_HOSTED_WEBHOOK_URL=
ALLOW_LOCAL_WEBHOOKS=false

# -----------------------------------------------------------------------------
# Database used by the bundled queue/postgres services
# -----------------------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# -----------------------------------------------------------------------------
# Resource tuning
# -----------------------------------------------------------------------------

CRAWL_CONCURRENT_REQUESTS=10
NUM_WORKERS_PER_QUEUE=8
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
BLOCK_MEDIA=

# -----------------------------------------------------------------------------
# Optional / normally not needed for deployment-only self-host
# -----------------------------------------------------------------------------

AUTUMN_SECRET_KEY=
SLACK_WEBHOOK_URL=
TEST_API_KEY=
SUPABASE_ANON_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_TOKEN=
LOGGING_LEVEL=
